# backend/.env.example
# ============================================================
# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored — never commit real credentials.
# ============================================================

# ── Google Drive cloud sync (set by cloud_setup.sh) ────────
# Name of your rclone remote (must match ~/.config/rclone/rclone.conf)
RCLONE_REMOTE=gdrive 666

# Base path on your Google Drive where brain data is stored
RCLONE_BASE_PATH=Quantum Cloud/MCAGI_BRAIN

# ── Optional: Wolfram Alpha ─────────────────────────────────
# WOLFRAM_APPID=YOUR_APP_ID_HERE

# ── Optional: MongoDB ───────────────────────────────────────
# MONGO_URI=mongodb://localhost:27017
